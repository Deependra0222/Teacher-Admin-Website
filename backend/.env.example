# Local HTTP server settings. No credentials belong in this file.
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
JSON_LIMIT=100kb

# Optional. Relative paths are resolved from backend/ when loaded from .env.
# STATIC_DIR=../teacher-website

# Teacher authentication is fail-closed by default.
# Use "emulator" for automated/local testing or "adc" for the existing live project.
FIREBASE_MODE=disabled

# Required when FIREBASE_MODE is emulator or adc.
# FIREBASE_PROJECT_ID=smartattend-e9a35

# Emulator-only settings. Do not include http:// in the host values.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Public Firebase Web App values copied from Firebase Console > Project settings.
# These identify the Web App and are not Firebase Admin credentials.
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=smartattend-e9a35.firebaseapp.com
# FIREBASE_WEB_PROJECT_ID=smartattend-e9a35
# FIREBASE_WEB_STORAGE_BUCKET=smartattend-e9a35.firebasestorage.app
# FIREBASE_WEB_MESSAGING_SENDER_ID=
# FIREBASE_WEB_APP_ID=

# In adc mode, Firebase Admin uses Application Default Credentials from the
# developer machine. Never copy a service-account JSON file into this project.
