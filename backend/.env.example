# Local HTTP server settings. No credentials belong in this file.
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
JSON_LIMIT=100kb

# Optional. Relative paths are resolved from backend/ when loaded from .env.
# STATIC_DIR=../teacher-website

# Teacher authentication is fail-closed by default.
# Use "emulator" for automated/local testing or "adc" for the existing live project.
FIREBASE_MODE=disabled

# Required when FIREBASE_MODE is emulator or adc. The live project ID below
# is verified from the existing Android registration; keep emulator mode on a
# separate demo project such as demo-smartattend.
FIREBASE_PROJECT_ID=smartattend-2a5ce

# Emulator-only settings. Do not include http:// in the host values.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Public Firebase Web App values copied from Firebase Console > Project settings.
# These identify the Web App and are not Firebase Admin credentials.
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=smartattend-2a5ce
FIREBASE_WEB_STORAGE_BUCKET=smartattend-2a5ce.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=1065635060805
# FIREBASE_WEB_APP_ID=

# In adc mode, Firebase Admin uses Application Default Credentials from the
# developer machine. Never copy a service-account JSON file into this project.
# A key file, if explicitly chosen for local testing, must remain outside the
# workspace and be referenced by GOOGLE_APPLICATION_CREDENTIALS at runtime.
