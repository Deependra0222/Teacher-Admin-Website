rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isTeacher() {
      return signedIn() && userRecord().data.role == "teacher";
    }

    function ownsStudentData(studentId) {
      return signedIn() && request.auth.uid == studentId;
    }

    match /users/{userId} {
      allow read: if ownsStudentData(userId) || isTeacher();
      // Roles and profiles are bootstrapped by a trusted administrator only.
      allow create, update, delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    match /enrollments/{enrollmentId} {
      allow read: if signedIn() &&
        (resource.data.studentId == request.auth.uid || isTeacher());
      allow write: if isTeacher();
    }

    match /timetable/{entryId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create, update: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;
      allow delete: if false;
    }

    match /presenceEvents/{eventId} {
      allow read: if isTeacher() ||
        (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          "studentId", "sessionId", "type", "occurredAt", "source", "simulated"
        ]) &&
        request.resource.data.source in ["simulation", "ble"] &&
        request.resource.data.simulated is bool;
      allow update, delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isTeacher() ||
        (signedIn() && resource.data.studentId == request.auth.uid);
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isTeacher();
      allow create: if isTeacher() &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 5;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

