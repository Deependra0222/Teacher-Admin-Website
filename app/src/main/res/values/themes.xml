<resources>
    <style name="Theme.SmartAttend" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#123563</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <style name="Theme.SmartAttend.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#123563</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartAttend</item>
    </style>
</resources>

